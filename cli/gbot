def calendar_settings():
    try:
        with open(CALENDAR_CONFIG) as source:
            settings = json.load(source)
        if not isinstance(settings, dict) or not isinstance(settings.get("calendars", []), list):
            return {}
        if any(not isinstance(value, str) for value in settings.get("calendars", [])):
            return {}
        return settings
    except (OSError, ValueError):
        return {}


def calendar_reader(action, calendars=()):
    if not os.path.isfile(CALENDAR_READER):
        return None, "Calendar: run gbot calendar connect to install the Apple Calendar reader"
    try:
        # LaunchServices gives GBOT Calendar a stable permission identity.
        # Direct execution inherits terminal permissions and fails under launchd.
        app = os.path.dirname(os.path.dirname(os.path.dirname(CALENDAR_READER)))
        with tempfile.TemporaryDirectory(prefix="gbot-calendar-") as folder:
            output = os.path.join(folder, "result.json")
            result = subprocess.run(["/usr/bin/open", "-g", "-j", "-W", "-n", app,
                                     "--args", action, *calendars, "--output", output],
                                    capture_output=True, text=True,
                                    timeout=180 if action == "authorize" else 20)
            with open(output) as source:
                data = json.load(source)
        if not isinstance(data, dict):
            raise ValueError()
        if result.returncode or data.get("error"):
            if data.get("authorization"):
                return None, ("Calendar: macOS Calendar access is missing; run "
                              "gbot calendar connect and grant access")
            return None, "Calendar: could not read the selected calendar"
        return data, None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None, "Calendar: the Apple Calendar reader did not respond"


def fetch_calendar():
    settings = calendar_settings()
    if not settings.get("enabled"):
        return None, None
    data, problem = calendar_reader("next", settings.get("calendars", []))
    if problem:
        return None, problem
    event = data.get("event")
    if event is None:
        return {}, None  # A successful empty query clears any cancelled meeting.
    try:
        start = event["start"]
        clock = event["time"]
        if (type(start) is not int or not 0 < start - time.time() <= 7 * 86400
                or not isinstance(event["id"], str) or not isinstance(event["title"], str)
                or not isinstance(clock, str) or len(clock) != 5 or clock[2] != ":"
                or not clock[:2].isdigit() or not clock[3:].isdigit()
                or not 0 <= int(clock[:2]) <= 23 or not 0 <= int(clock[3:]) <= 59):
            raise ValueError()
        key = hashlib.sha256((event["id"] + ":" + str(start)).encode()).hexdigest()[:16]
        return {"id": key, "start": start, "time": clock,
                "title": event["title"] or "Meeting"}, None
    except (KeyError, TypeError, ValueError):
        return None, "Calendar: invalid data for the next meeting"


def calendar_payload(event):
    seconds = math.ceil(event["start"] - time.time()) if event else 0
    if seconds <= 0:
        return "calendar clear"
    # Normalize to the font subset and prevent event-title newlines from
    # injecting additional USB commands.
    title = unicodedata.normalize("NFKD", event["title"]).encode("ascii", "ignore").decode()
    title = " ".join("".join(c if c.isalnum() or c in " .:%-/" else " "
                             for c in title).split())[:48] or "Meeting"
    return "calendar set %s %d %s %s" % (event["id"], seconds, event["time"], title)


def calendar_command(device=None, action=None):
    if action == "connect":
        if not os.path.isfile(CALENDAR_READER):
            script = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
                                  "scripts", "install-calendar.sh")
            subprocess.run(["bash", script], check=True)
        data, problem = calendar_reader("authorize")
        if problem:
            fail(problem)
        if data.get("authorization") != "authorized":
            fail("Calendar: macOS Calendar permission is missing")
        settings = dict(calendar_settings(), enabled=True, source="apple")
        os.makedirs(os.path.dirname(CALENDAR_CONFIG), exist_ok=True)
        fd = os.open(CALENDAR_CONFIG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as output:
            json.dump(settings, output)
        print("Apple Calendar connected. With gbot feed running, alerts start 5 min before and last 2 min.")
        return 0
    if action == "calendars":
        data, problem = calendar_reader("calendars")
        if problem:
            fail(problem)
        for calendar in data.get("calendars", []):
            print("%s  %s / %s" % (calendar["id"], calendar["source"], calendar["title"]))
        return 0
    if action == "status":
        fd, _ = connect(device)
        try:
            print(limits_command(fd, "calendar"))
        finally:
            close_port(fd)
        return 0
    event, problem = fetch_calendar()
    if problem or event is None:
        fail(problem or "Calendar: first connect Apple Calendar with gbot calendar connect")
    if event:
        print("Calendar\n%s\n%s" % (event["time"], event["title"]))
    else:
        print("Calendar: no meetings in the next 7 days.")
    if action != "terminal":
        fd, _ = connect(device)
        try:
            limits_command(fd, calendar_payload(event))
            limits_command(fd, "view calendar")
            limits_command(fd, "wake")
        finally:
            close_port(fd)
    return 0


def fetch_weather():
    """Fetch current Medellin weather as (data, None) or (None, error); no credentials."""
    code, data = _get_json(WEATHER_URL, {"Accept": "application/json",
                                         "User-Agent": "gbot"}, timeout=10)
    if code != 200 or not isinstance(data, dict):
        return None, "weather: Open-Meteo unavailable (HTTP %s)" % (code or "offline")
    current, units = data.get("current"), data.get("current_units")
    if not isinstance(current, dict) or not isinstance(units, dict):
        return None, "weather: response has no current conditions"
    expected = {"temperature_2m": "°C", "relative_humidity_2m": "%",
                "weather_code": "wmo code", "time": "unixtime"}
    if any(units.get(key) != unit for key, unit in expected.items()):
        return None, "weather: unexpected units; expected Celsius and UNIX time"
    values = [current.get(key) for key in expected]
    if any(isinstance(value, bool) or not isinstance(value, (int, float))
           or not math.isfinite(value) for value in values):
        return None, "weather: incomplete or invalid current conditions"
    temp, humidity, weather_code, observed = values
    if (not -90 <= temp <= 60 or not 0 <= humidity <= 100
            or humidity != int(humidity) or weather_code not in WMO_CODES
            or observed != int(observed) or not 0 <= time.time() - observed <= 2700):
        return None, "weather: conditions out of range or observation is stale"
    return {"temp_tenths": int(round(temp * 10)), "code": int(weather_code),
            "humidity": int(humidity), "observed_epoch": int(observed)}, None


def weather_payload(data):
    return "weather set %d %d %d %d" % (
        data["temp_tenths"], data["code"], data["humidity"], data["observed_epoch"])


def print_weather(data):
    local = datetime.datetime.fromtimestamp(data["observed_epoch"], BOGOTA)
    print("Medellín  %.1f °C  ·  Humidity %d%%\n"
          "Updated: %s (Colombia)  ·  Open-Meteo" %
          (data["temp_tenths"] / 10, data["humidity"], local.strftime("%d/%m/%Y %H:%M")))


