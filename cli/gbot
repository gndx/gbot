    return 0


def fetch_trm():
    """Fetch the Colombian reference rate in integer COP cents per USD."""
    from urllib.parse import urlencode
    today = datetime.datetime.fromtimestamp(time.time(), BOGOTA).date()
    date = today.isoformat() + "T00:00:00"
    query = urlencode({"$limit": 1, "$order": "vigenciadesde DESC",
                       "$where": "vigenciadesde <= '%s' AND vigenciahasta >= '%s'" %
                       (date, date)})
    status, rows = _get_json(TRM_URL + "?" + query,
                             {"Accept": "application/json", "User-Agent": "gbot"}, timeout=10)
    if status != 200 or not isinstance(rows, list):
        return None, "TRM: datos.gov.co unavailable (HTTP %s)" % (status or "offline")
    if not rows:
        return None, "TRM: no rate valid for today in datos.gov.co"
    try:
        row = rows[0]
        amount = Decimal(str(row["valor"]))
        start = datetime.date.fromisoformat(row["vigenciadesde"][:10])
        end = datetime.date.fromisoformat(row["vigenciahasta"][:10])
        if (not amount.is_finite() or not Decimal("0.01") <= amount <= Decimal("99999.99")
                or amount * 100 != (amount * 100).to_integral_value()
                or not start <= today <= end or (end - start).days > 31):
            raise ValueError("invalid value or validity period")
        expires = datetime.datetime.combine(end + datetime.timedelta(days=1),
                                              datetime.time(), BOGOTA).timestamp()
        remaining = int(expires - time.time())
        if remaining <= 0:
            return None, "TRM: validity changed during the request; try again"
        return {"cents": int(amount * 100), "from_day": int(start.strftime("%Y%m%d")),
                "to_day": int(end.strftime("%Y%m%d")), "valid_for": remaining}, None
    except (KeyError, IndexError, TypeError, ValueError, InvalidOperation, OverflowError):
        return None, "TRM: response has an invalid value or validity period"


def cop_amount(cents):
    whole, fraction = divmod(cents, 100)
    return format(whole, ",").replace(",", ".") + ",%02d" % fraction


def trm_payload(data):
    return "trm set %d %d %d %d" % (data["cents"], data["from_day"],
                                     data["to_day"], data["valid_for"])


def print_trm(data):
    def date(day):
        return "%02d/%02d/%04d" % (day % 100, day // 100 % 100, day // 10000)
    validity = date(data["from_day"])
    if data["from_day"] != data["to_day"]:
        validity += " to " + date(data["to_day"])
    print("TRM  ·  1 USD = $%s COP\nValid: %s (Colombia)\n"
          "Source: Superintendencia Financiera · datos.gov.co" % (cop_amount(data["cents"]), validity))


